<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">타이머 잠금</string>
    <string name="service_label">타이머 잠금</string>
    <string name="service_description">선택한 앱을 열면 1분·3분·5분 타이머 화면을 띄우고, 시간이 끝나면 그 앱을 닫습니다. 어떤 앱이 화면 앞에 열렸는지(앱 이름)만 확인하며, 화면 내용이나 입력한 글자는 읽지 않습니다.</string>

    <string name="perm_title_off">접근성 권한을 켜 주세요</string>
    <string name="perm_body_off">앱이 열리는 순간을 감지하려면 접근성 서비스가 필요합니다.\n\n1. 아래 \'접근성 설정 열기\' → 설치된 앱(또는 다운로드한 앱) → \'타이머 잠금\'을 켜 주세요.\n2. 스위치가 회색으로 눌리지 않으면(제한된 설정): \'앱 정보 열기\' → 오른쪽 위 ⋮ → \'제한된 설정 허용\' 후 다시 1번을 해 주세요.</string>
    <string name="perm_title_on">작동 중</string>
    <string name="perm_body_on">접근성 서비스가 켜져 있습니다. 타이머 대상 앱을 열면 타이머 화면이 나타나고, 시간이 끝나면 그 앱이 닫힙니다.</string>
    <string name="open_accessibility">접근성 설정 열기</string>
    <string name="open_app_info">앱 정보 열기</string>

    <string name="master_switch">타이머 잠금 사용</string>
    <string name="strict_switch">화이트리스트 외 모든 앱에 타이머</string>
    <string name="strict_desc">켜면 화이트리스트(허용)로 체크한 앱을 빼고 모든 앱에 기본 타이머가 걸립니다. 끄면 직접 고른 앱에만 걸립니다.</string>
    <string name="default_duration">기본 타이머 시간</string>
    <string name="search_hint">앱 이름 검색</string>
    <string name="filter_all">전체</string>
    <string name="filter_blocked">타이머</string>
    <string name="filter_whitelist">화이트리스트</string>
    <string name="apps_header">앱을 눌러 타이머(1·3·5분) 또는 화이트리스트를 정하세요</string>
    <string name="loading">앱 목록을 불러오는 중…</string>
    <string name="empty">해당하는 앱이 없습니다</string>

    <string name="overlay_title">잠깐 쉬어 가요</string>
    <string name="overlay_body">타이머가 끝나면 이 앱은 자동으로 닫혀요</string>
    <string name="overlay_whitelist">화이트리스트 앱 열기</string>
    <string name="whitelist_title">화이트리스트 앱</string>
    <string name="whitelist_empty">화이트리스트로 체크한 앱이 없어요.\n타이머 잠금 앱에서 앱을 눌러 \'화이트리스트\'로 지정하세요.</string>
    <string name="whitelist_back">타이머로 돌아가기</string>
    <string name="whitelist_remaining">남은 시간 %1$s</string>
    <string name="closed_toast">시간이 끝나 %1$s 을(를) 닫았어요</string>
</resources>
